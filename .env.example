APP_NAME=FlyRank Image Relevance Engine
DATABASE_URL=sqlite:///./image_relevance.db
VISION_PROVIDER=local
EMBEDDING_PROVIDER=local

# Optional OpenRouter vision provider. Keep the key empty in this example.
# Set VISION_PROVIDER=openrouter in your private .env to enable it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallback model IDs. Verify they support image input and are currently free.
OPENROUTER_FALLBACK_MODELS=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=all-minilm
VISION_CONFIDENCE_THRESHOLD=0.60
MATCH_SIMILARITY_THRESHOLD=0.18
MAX_BATCH_RETRIES=2
ESTIMATED_VISION_CALL_COST_USD=0
ESTIMATED_EMBEDDING_CALL_COST_USD=0
ASSET_DIR=assets/demo
